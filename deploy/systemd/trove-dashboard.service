# trove-dashboard.service — template for the Trove dashboard user service.
#
# Do NOT install this file as-is: it contains double-underscore placeholder
# tokens that `deploy/setup.sh` substitutes (rendered copy lands at
# ~/.config/systemd/user/trove-dashboard.service). Manual install =
# run `./deploy/setup.sh <type>` (idempotent) or replicate what it does:
# substitute the three tokens, drop the result in ~/.config/systemd/user/,
# then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now trove-dashboard
#
# Substituted tokens (in order of appearance):
#   the `trove` console script (absolute path; setup.sh prefers
#   <repo>/.venv/bin/trove, falling back to a `trove` on PATH).
#   Absolute path on purpose: user services get a minimal PATH, so the
#   unit carries no Environment=PATH line.
#   the trove-only env file (TROVE_* keys only, generated by setup.sh
#   from the profile .env).
#   the Trove checkout (WorkingDirectory only).
#
# The token expands to the `trove` console script itself, so ExecStart
# is `<token> dashboard` — do NOT write `<token> trove dashboard`
# (the console script already IS the trove CLI; the extra `trove`
# argument makes it exit 0 immediately and the service restart-loops).
#
# Env: `EnvironmentFile` (NO dash prefix — systemd does not support the
# optional-file `-` form for this key; a missing file fails service start,
# which is the right loud failure for a mis-deploy). The file is always
# created by setup.sh (possibly empty — an empty file means "no labels"),
# so it exists whenever this unit is installed by setup. Re-run
# `./deploy/setup.sh` after ANY TROVE_* change to the profile .env (the
# file is a snapshot, not a link), then `systemctl --user restart
# trove-dashboard`.
#
# Access (D3: loopback + SSH tunnel): the dashboard binds 127.0.0.1
# only (the trove dashboard default). From a remote machine:
#   ssh -L 9120:127.0.0.1:9120 <user>@<host>
# then open http://127.0.0.1:9120 in the local browser. Do not add a
# `--host` flag that widens the bind — the repo default is loopback and
# there is no remote-exposure requirement.

[Unit]
Description=Trove Nugget Browser Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=__ENV_FILE__
ExecStart=__TROVE_BIN__ dashboard
WorkingDirectory=__REPO__
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
